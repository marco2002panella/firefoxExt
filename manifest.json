{
  "manifest_version": 2,
  "name": "US Keyboard Sender",
  "version": "2.1",
  "description": "Converte la tastiera IT in tasti con layout US su qualsiasi pagina web, con pannello sempre visibile.",
  "browser_specific_settings": { "gecko": { "id": "us-keyboard-sender@marco2002panella" } },
  "permissions": ["<all_urls>", "tabs", "webNavigation", "clipboardRead"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "US Keyboard Sender (mostra/nascondi pannello)" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true }
  ]
}
